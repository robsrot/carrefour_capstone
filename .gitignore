# DATA — never commit
data/raw/*
data/processed/*
data/dev/*
!data/raw/csv/
!data/raw/csv/.gitkeep
!data/raw/parquet/
!data/raw/parquet/.gitkeep
!data/processed/.gitkeep
!data/dev/.gitkeep

# Common data formats (safety net anywhere in repo)
*.csv
*.parquet
*.feather
*.xlsx
*.json
*.pkl
*.zip
*.tar.gz
*.gz


# Legacy local artifacts from the old root-level model path
models/

# Generated pipeline artifacts, including mode-scoped models and experiments
outputs/*
!outputs/.gitkeep

# PYTHON
__pycache__/
*.py[cod]
*.egg-info/
.pt/
.venv/
venv/
.env
.tmp/

# JUPYTER
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
