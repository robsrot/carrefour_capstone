# DATA — never commit
data/raw/*
data/processed/*
data/dev/*
!data/raw/csv/
!data/raw/csv/.gitkeep
!data/raw/parquet/
!data/raw/parquet/.gitkeep
!data/processed/.gitkeep
!data/dev/.gitkeep

# Common data formats (safety net anywhere in repo)
*.csv
*.parquet
*.feather
*.xlsx
*.json
*.pkl
*.zip
*.tar.gz
*.gz

# Metadata JSON files that must be tracked
!data/processed/quality_report.json
!data/dev/subset_metadata.json

# MODELS — too large for git
models/*
!models/.gitkeep
!models/dev/
models/dev/*
!models/dev/*.json
!models/prod/
models/prod/*
!models/prod/*.json

# OUTPUTS
outputs/*
!outputs/.gitkeep

# PYTHON
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# JUPYTER
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db